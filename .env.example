# Postgres fornecido por uma integração do Vercel Marketplace, como Neon.
# Use POSTGRES_URL ou DATABASE_URL. Nunca use o prefixo VITE_ nesta variável.
POSTGRES_URL=
DATABASE_URL=

# Gere com: openssl rand -base64 48
# Mínimo recomendado: 32 caracteres.
SESSION_SECRET=

# Credenciais do usuário administrativo do painel.
# Nunca publique esses valores no frontend.
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=

# Opcional: domínio público para integrações externas e metadados.
PUBLIC_APP_URL=https://seudominio.vercel.app
